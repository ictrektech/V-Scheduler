        "scheme": "bearer",
        "description": "V-Scheduler issued scoped credential, independent of VOS JWT. Enrollment uses separately scoped short-lived bootstrap credential."
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "required": [
          "code",
          "category",
          "data",
          "msg",
          "version",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "v-scheduler"
            ]
          },
          "data": {},
          "msg": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "enum": [
              "1"
            ]
          },
